class Provedor {
  int? codProvedor;
  String? emailProvedor;
  String? nomeProvedor;
  String? senhaProvedor;
  String? cidadeProvedor;
  String? cpfProvedor;
  String? bairro;
  String? servico;
  String? descricao;
  String? preco;
  String? dataHora;
  Null? telefone;
  int? codConsumidor;
  Consumidor? consumidor;

  Provedor(
      {this.codProvedor,
      this.emailProvedor,
      this.nomeProvedor,
      this.senhaProvedor,
      this.cidadeProvedor,
      this.cpfProvedor,
      this.bairro,
      this.servico,
      this.descricao,
      this.preco,
      this.dataHora,
      this.telefone,
      this.codConsumidor,
      this.consumidor});

  Provedor.fromJson(Map<String, dynamic> json) {
    codProvedor = json['cod_provedor'];
    emailProvedor = json['email_provedor'];
    nomeProvedor = json['nome_provedor'];
    senhaProvedor = json['senha_provedor'];
    cidadeProvedor = json['cidade_provedor'];
    cpfProvedor = json['cpf_provedor'];
    bairro = json['bairro'];
    servico = json['servico'];
    descricao = json['descricao'];
    preco = json['preco'];
    dataHora = json['data_hora'];
    telefone = json['telefone'];
    codConsumidor = json['cod_consumidor'];
    consumidor = json['consumidor'] != null
        ? new Consumidor.fromJson(json['consumidor'])
        : null;
  }

  Map<String, dynamic> toJson() {
    final Map<String, dynamic> data = new Map<String, dynamic>();
    data['cod_provedor'] = this.codProvedor;
    data['email_provedor'] = this.emailProvedor;
    data['nome_provedor'] = this.nomeProvedor;
    data['senha_provedor'] = this.senhaProvedor;
    data['cidade_provedor'] = this.cidadeProvedor;
    data['cpf_provedor'] = this.cpfProvedor;
    data['bairro'] = this.bairro;
    data['servico'] = this.servico;
    data['descricao'] = this.descricao;
    data['preco'] = this.preco;
    data['data_hora'] = this.dataHora;
    data['telefone'] = this.telefone;
    data['cod_consumidor'] = this.codConsumidor;
    if (this.consumidor != null) {
      data['consumidor'] = this.consumidor!.toJson();
    }
    return data;
  }
}

class Consumidor {
  int? codConsumidor;
  String? nomeConsumidor;
  String? emailConsumidor;
  String? senhaConsumidor;
  String? cpfConsumidor;
  List<Null>? provedor;

  Consumidor(
      {this.codConsumidor,
      this.nomeConsumidor,
      this.emailConsumidor,
      this.senhaConsumidor,
      this.cpfConsumidor,
      this.provedor});

  Consumidor.fromJson(Map<String, dynamic> json) {
    codConsumidor = json['cod_consumidor'];
    nomeConsumidor = json['nome_consumidor'];
    emailConsumidor = json['email_consumidor'];
    senhaConsumidor = json['senha_consumidor'];
    cpfConsumidor = json['cpf_consumidor'];
    if (json['provedor'] != null) {
      provedor = <Null>[];
      json['provedor'].forEach((v) {
        provedor!.add(new Null.fromJson(v));
      });
    }
  }

  Map<String, dynamic> toJson() {
    final Map<String, dynamic> data = new Map<String, dynamic>();
    data['cod_consumidor'] = this.codConsumidor;
    data['nome_consumidor'] = this.nomeConsumidor;
    data['email_consumidor'] = this.emailConsumidor;
    data['senha_consumidor'] = this.senhaConsumidor;
    data['cpf_consumidor'] = this.cpfConsumidor;
    if (this.provedor != null) {
      data['provedor'] = this.provedor!.map((v) => v.toJson()).toList();
    }
    return data;
  }
}
